# ===================================================================
# WELFARECONNECT ENVIRONMENT CONFIGURATION
# ===================================================================

# Secret key for signing session cookies.
# Required in production: must be a strong random secret.
# In local development: leave unset to auto-generate a persistent key in instance/.secret_key
SECRET_KEY=generate-a-secure-random-32-byte-hex-key

# Database Connection URI:
# -------------------------------------------------------------
# 1. Local SQLite (Default - resolves deterministically inside instance/ directory):
DATABASE_URL=sqlite:///welfare.db

# 2. Managed PostgreSQL (e.g. Render / Heroku / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/welfare_db

# 3. MySQL (requires pymysql driver):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/welfare_db

# Application Environment:
FLASK_ENV=development

# Optional Seed Credentials (only applied when database is newly initialized):
# ADMIN_PASSWORD=your_initial_admin_password
# DEMO_USER_PASSWORD=your_initial_demo_password

